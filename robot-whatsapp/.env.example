# Adresse de l'application (ne pas changer sauf si l'adresse du site change)
APP_URL=https://apespot-wifi.vercel.app

# Clé secrète APESPOT (fournie par l'administrateur) — ne pas partager
CLE=COLLE_LA_CLE_ICI

# Heures de vérification des rappels clients (plusieurs par jour, rattrapage).
# Heure de Lomé. Un client déjà relancé dans la journée n'est pas renotifié.
HEURES_ENVOI=8,10,14

# Fréquence de vérification des alertes équipe (paiement/ticket/réclamation), en minutes
ALERTE_INTERVALLE_MIN=3
